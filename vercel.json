{
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "web-build",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/((?!assets/|_expo/|.*\\..*).*)", "destination": "/index.html" }
  ]
}